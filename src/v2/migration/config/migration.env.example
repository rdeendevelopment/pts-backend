# Legacy/source database (read-only during migration)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=rdn_pts_dev

# Target v2 database (pts_* collections only)
MONGO_V2_DB=pts_v2_dev

# Optional seed admin (non-production defaults)
PTS_V2_SEED_ADMIN_EMAIL=admin@example.com
PTS_V2_SEED_ADMIN_PASSWORD=Password123
PTS_V2_SEED_ADMIN_FIRST_NAME=Admin
PTS_V2_SEED_ADMIN_LAST_NAME=User

# v2 business config (passed through to migration runs)
PTS_V2_BUSINESS_TIMEZONE=UTC
PTS_V2_WEEK_START_DAY=monday
