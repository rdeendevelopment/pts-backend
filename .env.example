# Copy to .env for local overrides (optional — config.yaml is the primary source)
# Env vars take precedence over config.yaml when set.

PTS_AI_ENABLED=true
PTS_AI_DEBUG_ENABLED=true
OPENAI_API_KEY=sk-your-key-here
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=https://api.openai.com/v1
PTS_AI_MAX_OUTPUT_TOKENS=2048

# My Day / Daily Flow AI (FlowMate AI)
DAILY_FLOW_AI_ENABLED=true
DAILY_FLOW_AI_MODEL=gpt-4o-mini
DAILY_FLOW_AI_TIMEOUT_MS=15000
